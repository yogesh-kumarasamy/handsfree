{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HandsFree",
  "version": "0.1.0",
  "identifier": "co.anywhere.handsfree",
  "build": {
    "beforeDevCommand": "npm run build:engine && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HandsFree",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../engine/dist/handsfree-engine.mjs": "engine/handsfree-engine.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
